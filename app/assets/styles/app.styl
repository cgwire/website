@import "./variables.styl"

// ============================================================================
// FONTS
// ============================================================================

@font-face
    font-family lato
    src url("~/assets/fonts/lato.woff2")
    font-display swap

// Every rule sits under these three selectors, so the imports stay inside
// the block. Their order is the cascade order: do not sort them.
html
body
div.body
    margin 0
    font-family lato, sans-serif
    font-size 18px

    @import "./base.styl"
    @import "./components.styl"
    @import "./header.styl"
    @import "./pages/landing.styl"
    @import "./pages/kitsu.styl"
    @import "./pages/community.styl"
    @import "./pages/integrations.styl"
    @import "./pages/studios.styl"
    @import "./pages/about.styl"
    @import "./pages/pricing.styl"
    @import "./pages/compare.styl"
    @import "./pages/faq.styl"
    @import "./responsive.styl"
