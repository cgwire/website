// ========================================================================
// COMPONENTS
// ========================================================================

// --- Modules ---

.modules
    // .flexrow centers its items: stretch keeps the three tiles the same
    // height when a locale wraps a line.
    align-items stretch
    gap 20px
    margin auto
    margin-bottom 10px

    .module-block
        flex 1
        max-width 320px
        background lightblue
        border-radius 1em
        border 1px solid lightblue - 10%
        padding 1em
        padding-bottom 1.1em
        transition border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease

        &:hover
        &:focus-visible
            border-color lightblue - 30%
            box-shadow 0 8px 20px rgba(63, 111, 174, 0.18)
            transform translateY(-3px)

        .module-description
            color grey

        img
            background white
            border-radius 1em
            width 100%

// --- Quotes (home testimonials, QuoteContentBlock) ---

.lean-quote-text
    border-radius 20px
    border 1px solid #dbe8ff
    padding-left 1.5rem
    line-height 1.3
    font-size 1em
    font-weight bold
    color text-slate

    p:before
        content "\201C"

    p:after
        content "\201D"

.lean-quote-author
    display flex
    align-items center
    margin-top .6rem
    font-size 1rem
    font-style italic

.lean-quote-avatar
    border-radius 50%
    margin-right .6rem
    flex 0 0 auto
    width 56px
    height 56px

// --- Successes ---

.successes
    display flex
    flex-direction row
    justify-content space-between
    align-items center
    gap 1em
    margin-bottom 12em

    // Equal flex basis: logos shrink from their intrinsic width otherwise,
    // so a 500px source ends up larger than its 400px neighbours.
    img
        flex 1 1 0
        min-width 0
        max-width 280px
        border-radius 10px
        padding 0.5em
        box-shadow light-shadow

    @media (max-width: 768px)
        flex-direction column
        align-items center
        gap 2em

        img
            flex none
            width 100%

    // The Gobelins logo fills more of its canvas than the other school
    // logos: inset it so the three read at the same visual size.
    img[alt="Gobelins"]
        padding 1.5em
        background white

.best-supporter > img
    border-radius 1em
    box-shadow light-shadow

// --- Supporters ---

.supporters
    padding-top 6em
    background lightgrey
    border-radius 5em

    h2.subtitle.tagline
        margin-bottom 0.5em

    .flexrow-item.mr0
        margin-right 0

section.section.trusted
    max-width 100%

    .flexrow-item.mr0
        margin-right 0

// --- Tabs (feature tabs) ---

.js-tabs
    display flex
    align-items flex-start
    margin-top 3.5rem
    .js-tablist
        box-sizing border-box
        flex 0 0 33%
        list-style none
        padding 0 1em 0 0
        margin 0
    .js-tablist__link
        display flex
        align-items center
        justify-content flex-start
        padding .5rem 1rem
        border-radius .55rem
        opacity .4
        color darkgrey
        font-size 1.1em
        font-weight bold

        &:active
        &:focus
        &[aria-selected=true]
            background-color alpha(cgwiregreen, .1)
            opacity 1
            outline 0

        img
            margin-right 1.28rem
            width 2.8rem
            flex 0 0 auto

    .js-tabcontent
        box-sizing border-box
        flex 1 1 66%
        background-color lightgrey
        border-radius .55rem
        padding 2.22rem

.js-tabs
    [aria-hidden]
        display none

// --- Customer stories ---

.customer-story.landing-block
    padding-top 1.5em
    border-radius 2em
    background lightpurple
    border 1px solid lightpurple - 10%
    padding-left 1.5em
    margin auto
    max-width 1000px

    .flexrow-item:first-child
        margin-right 2em

    .supporters
        .flexrow-item.mr0
            margin-right 1em
        .flexrow-item.mr0:last-child
            margin-right 0
    img
        max-width 400px
        border-radius 2em
        box-shadow light-shadow

    .section-subtitle
        color text-slate
        font-size 1.3em

    .landing-text
        p
            color darkgrey
            max-width 500px
            margin 0
            padding 0

// --- Landing blocks ---

.landing-block
    &.content
        margin-bottom 2em
        padding-bottom 1em

    .landing-text
        p
            max-width 300px
            margin auto

        h2.subtitle
            max-width 300px
            font-weight bold
            line-height 1.4em
            text-align left
            margin 0 auto 1em auto

// --- Customers grid ---

.customers
    list-style none
    max-width 1000px
    padding 0
    display flex
    align-items flex-start
    flex-wrap wrap

.customers-item
    flex 0 0 auto
    width 9.95rem
    height 9.95rem
    padding 1rem
    display flex
    align-items center
    justify-content center
    color white
    transition transform 0.2s ease
    border-radius 1rem
    margin 1em

    &:hover
        transform scale(1.1)

    &:nth-child(14n+1)
        background-color rainbow-1
    &:nth-child(14n+2)
        background-color rainbow-2
    &:nth-child(14n+3)
        background-color rainbow-3
    &:nth-child(14n+4)
        background-color rainbow-4
    &:nth-child(14n+5)
        background-color rainbow-5
    &:nth-child(14n+6)
        background-color rainbow-6
    &:nth-child(14n+7)
        background-color rainbow-7
    &:nth-child(14n+8)
        background-color rainbow-8
    &:nth-child(14n+9)
        background-color rainbow-9
    &:nth-child(14n+10)
        background-color rainbow-10
    &:nth-child(14n+11)
        background-color rainbow-11
    &:nth-child(14n+12)
        background-color rainbow-12
    &:nth-child(14n+13)
        background-color rainbow-13
    &:nth-child(14n+14)
        background-color rainbow-14

// --- Quotes ---

.quote
    background-color lightgrey
    padding 6.5rem

.quote-text
    border-left 8px solid cgwiregreen
    padding-left 2.22rem
    line-height 1.3
    font-size 2em
    font-weight bold
    color text-slate

    p:before
        content "\201C"

    p:after
        content "\201D"

.quote-author
    display flex
    align-items center
    margin-top .8rem
    font-size 1.45rem
    color cgwiregreen
    font-weight normal

.quote-avatar
    border-radius 50%
    margin-right .8rem
    flex 0 0 auto
    width 80px
    height 80px

// --- Check list ---

.check-list
    list-style none
    margin 0 0 2.5rem
    padding 0
    font-size 1.22em
    line-height 1.8

    li::before
        content ""
        display inline-block
        width 1.25rem
        height 1rem
        margin-right .8rem
        background url('~/assets/images/icons/check.svg') 0 0 / contain no-repeat

// --- Video ---

.video
    background-color lightgrey
    padding 3.5rem 0

    iframe
        width 100%
        height auto
        aspect-ratio 16 / 9
        background-color black
        border-radius 20px

    // Caption under the video.
    .flexrow
        flex-direction column
        max-width 900px
        margin 0 auto

    .flex-item
        width 100%

.video-text
    padding 1rem
    text-align center
    font-size 1.5rem
    font-weight bold
    line-height 1.3
    color darkgrey
    a
        color darkgrey
        text-decoration none

// --- Content layout ---

.content-image
    padding-left 3rem

.content-reverse
    flex-direction row-reverse

    .content-image
        padding-left 0
        padding-right 3rem
