// ========================================================================
// PAGE: ABOUT
// ========================================================================

.ppl
    padding 1.5rem

.ppl-image
    margin 0 auto
    max-width 150px
    img
        width 150px
        border-radius 50%

.ppl-id
    margin 1.3rem 0 1.5rem
    text-align center

    .ppl-id-name
        margin-bottom 0
        font-size 1.5rem
        font-weight bold

    .ppl-id-role
        font-size 1.1rem
        color mediumgrey

.ppl-description
    flex 1

@media(max-width: 800px)
    .ppl
        flex-direction column

        .flexrow-item
            margin-right 0

        .ppl-image
            margin-bottom 1em
