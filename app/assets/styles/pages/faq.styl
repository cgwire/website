// ========================================================================
// FAQ
// ========================================================================

.content
    div.faq
        max-width 650px
        margin auto
        margin-top 3em

        .question
            background lightblue
            border 1px solid lightblue - 5%
            border-radius 8px
            color grey - 20%
            font-size 1em
            margin-bottom .5em
            padding .8em
            padding-right 1.6em
            position relative

        p.answer
            margin-top 0
            padding .5em

        .contract
        .expand
            cursor pointer
            position absolute
            right 0
            top 16px
            width 25px
